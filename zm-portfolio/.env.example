# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon / publishable key ONLY. Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public address of the deployed site (used for canonical + social preview tags)
SITE_URL=https://your-domain.com

# ---- Server-only secrets (NEVER prefix with VITE_, never commit real values) ----
# Google AI Studio → Get API key. Used only by the server route /api/ai.
# Local: put it in .env.local (git-ignored). Production: Vercel → Settings → Environment Variables.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.5-flash)
# GEMINI_MODEL=
